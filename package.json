{
  "name": "doer-agent",
  "version": "0.9.1",
  "description": "Reverse-polling agent runtime for doer",
  "type": "module",
  "main": "dist/agent.js",
  "bin": {
    "doer-agent": "dist/cli.js",
    "codex": "dist/codex-cli.js"
  },
  "files": [
    "dist",
    "runtime",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js dist/codex-cli.js",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node --import tsx src/agent.ts",
    "start:dist": "node dist/agent.js",
    "codex": "codex",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex": "^0.144.5",
    "@openai/codex-sdk": "^0.144.5",
    "diff": "^9.0.0",
    "nats": "^2.29.3",
    "tar": "^7.5.15"
  },
  "devDependencies": {
    "@types/node": "^20.19.40",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
